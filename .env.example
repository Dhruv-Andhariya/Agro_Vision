# AgroVision environment example
# Copy the server values into server/.env and the client values into client/.env

# --------------------
# Server (.env)
# --------------------
PORT=5000
MONGO_URI=your_mongodb_connection_string
AI_SERVICE_URL=http://127.0.0.1:8000/predict
JWT_SECRET=change_this_to_a_long_random_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Email SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email_address@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=AgroVision <your_email_address@example.com>
CLIENT_URL=http://localhost:5173

# --------------------
# Client (.env)
# --------------------
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
